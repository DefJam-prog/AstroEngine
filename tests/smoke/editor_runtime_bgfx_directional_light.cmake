if(NOT DEFINED APP OR NOT EXISTS "${APP}")
    message(FATAL_ERROR "Runtime BGFX directional light smoke app does not exist: ${APP}")
endif()
if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "Runtime BGFX directional light smoke requires a build-local WORK_DIR")
endif()

file(MAKE_DIRECTORY "${WORK_DIR}")
set(_screenshot "${WORK_DIR}/runtime-bgfx-directional-light.tga")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "ASTRO_EDITOR_SCREENSHOT_OUTPUT=${_screenshot}"
        "${APP}" --smoke-runtime-bgfx-directional-light
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 55)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Runtime BGFX directional light smoke failed (${_result})\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "runtimeBgfxDirectionalLightPixels=[1-9][0-9]*")
    message(FATAL_ERROR "Runtime Game View did not report directional-lit pixels\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "sceneViewDirectionalLightPixels=[1-9][0-9]*")
    message(FATAL_ERROR "Editor Scene View did not report directional-lit pixels\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "sceneViewFrontLitPixels=[1-9][0-9]* sceneViewBackLitPixels=0")
    message(FATAL_ERROR "Scene View front/back lighting regions did not match the oriented fixture\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "directionalLightInspectorControls=1"
        OR NOT _stdout MATCHES "directionalLightInspectorCommands=1")
    message(FATAL_ERROR "DirectionalLight3D Inspector controls/command regression failed\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "lightInspectorKeyboard=1 target=directional enabledDraft=1 valueFieldEdited=1 draftOnly=1 sceneUnchanged=1 sdl=1")
    message(FATAL_ERROR "DirectionalLight3D Inspector keyboard regression failed\n${_stdout}\n${_stderr}")
endif()
string(REGEX MATCH "lightInspectorKeyboardProbe=[^\r\n]*" _keyboard_probe "${_stdout}")
if(NOT _keyboard_probe)
    message(FATAL_ERROR "Directional light keyboard probe did not report activation state\n${_stdout}\n${_stderr}")
endif()
string(REGEX MATCH "sceneViewFrontLitPixels=([0-9]+) sceneViewBackLitPixels=([0-9]+)"
    _face_match "${_stdout}")
set(_front_pixels "${CMAKE_MATCH_1}")
set(_back_pixels "${CMAKE_MATCH_2}")
string(REGEX MATCH "runtimeBgfxDirectionalLightPixels=([0-9]+)" _game_match "${_stdout}")
set(_game_pixels "${CMAKE_MATCH_1}")
string(REGEX MATCH "sceneViewDirectionalLightPixels=([0-9]+)" _scene_match "${_stdout}")
set(_scene_pixels "${CMAKE_MATCH_1}")
if(NOT EXISTS "${_screenshot}")
    message(FATAL_ERROR "Runtime BGFX directional light screenshot was not saved: ${_screenshot}")
endif()
file(SIZE "${_screenshot}" _screenshot_size)
if(_screenshot_size LESS 100000)
    message(FATAL_ERROR "Runtime BGFX directional light screenshot is too small (${_screenshot_size} bytes)")
endif()

function(_capture_no_light_shader mode stem)
    set(_shot "${WORK_DIR}/${stem}.tga")
    set(_raw "${WORK_DIR}/${stem}-scene-view.raw")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -E env
            "ASTRO_EDITOR_SCREENSHOT_OUTPUT=${_shot}"
            "ASTRO_EDITOR_SCENEVIEW_RAW_OUTPUT=${_raw}"
            "${APP}" "${mode}"
        RESULT_VARIABLE _case_result OUTPUT_VARIABLE _case_stdout ERROR_VARIABLE _case_stderr TIMEOUT 55)
    if(NOT _case_result EQUAL 0)
        message(FATAL_ERROR "No-light capture ${mode} failed (${_case_result})\n${_case_stdout}\n${_case_stderr}")
    endif()
    if(NOT EXISTS "${_raw}" OR NOT EXISTS "${_shot}")
        message(FATAL_ERROR "No-light capture ${mode} did not produce the requested view crop/screenshot")
    endif()
    if(NOT _case_stdout MATCHES "framebufferReadback case=directional-no-light scene=[0-9]+/[0-9]+ maxDelta=[0-9]+ game=[0-9]+/[0-9]+ maxDelta=[0-9]+")
        message(FATAL_ERROR "No-light capture ${mode} did not report Scene/Game framebuffer readback comparisons\n${_case_stdout}\n${_case_stderr}")
    endif()
    string(REGEX MATCH "framebufferReadback case=directional-no-light scene=([0-9]+)/([0-9]+) maxDelta=([0-9]+) game=([0-9]+)/([0-9]+) maxDelta=([0-9]+)"
        _readback_match "${_case_stdout}")
    message(STATUS "${mode} BGFX framebuffer vs final-window samples: Scene ${CMAKE_MATCH_1}/${CMAKE_MATCH_2}, maxDelta=${CMAKE_MATCH_3}; Game ${CMAKE_MATCH_4}/${CMAKE_MATCH_5}, maxDelta=${CMAKE_MATCH_6} (threshold: 99.5%, per-channel tolerance 8/255)")
    set(${stem}_RAW "${_raw}" PARENT_SCOPE)
endfunction()

_capture_no_light_shader(--smoke-runtime-bgfx-directional-light-legacy legacy)
_capture_no_light_shader(--smoke-runtime-bgfx-directional-light-zero zero)
file(SHA256 "${legacy_RAW}" _legacy_sha)
file(SHA256 "${zero_RAW}" _zero_sha)
if(NOT _legacy_sha STREQUAL _zero_sha)
    message(FATAL_ERROR "Zero-light Lambert shader changed Scene View pixels: legacy=${_legacy_sha}; zero=${_zero_sha}")
endif()
message(STATUS "Directional diffuse smoke passed; sceneViewPixels=${_scene_pixels}; gameViewPixels=${_game_pixels}; front=${_front_pixels}; back=${_back_pixels}; screenshot=${_screenshot}")
message(STATUS "${_keyboard_probe}")
message(STATUS "No-light Scene View raw crop SHA256 matches legacy/zero-light shaders: ${_zero_sha}")
