if(NOT DEFINED APP OR NOT EXISTS "${APP}")
    message(FATAL_ERROR "Runtime BGFX Game View texture smoke app does not exist: ${APP}")
endif()
if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "Runtime BGFX Game View texture smoke requires a build-local WORK_DIR")
endif()

file(MAKE_DIRECTORY "${WORK_DIR}")
set(_screenshot "${WORK_DIR}/runtime-bgfx-game-view-texture.tga")
set(_environment "ASTRO_EDITOR_SCREENSHOT_OUTPUT=${_screenshot}")
set(_filter "9987")
set(_argument "--smoke-runtime-bgfx-game-view-texture")
set(_renderer "Direct3D 11")
if(DEFINED FILTER)
    set(_filter "${FILTER}")
    list(APPEND _environment "ASTRO_RUNTIME_BGFX_MIP_FILTER=${FILTER}")
endif()
if(MASK)
    list(APPEND _environment "ASTRO_RUNTIME_BGFX_MASK_SMOKE=1")
endif()
if(VULKAN)
    set(_argument "--smoke-runtime-bgfx-vulkan-game-view-texture")
    set(_renderer "Vulkan")
endif()
if(COLOR_CHART)
    list(APPEND _environment "ASTRO_VULKAN_COLOR_CHART_SMOKE=1")
endif()
if(TAP)
    list(APPEND _environment "ASTRO_VULKAN_GAME_VIEW_TAP_SMOKE=1")
    if(TAP_SIZE STREQUAL "1100x720")
        list(APPEND _environment "ASTRO_VULKAN_GAME_VIEW_RESIZE_TRACE=1")
        string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef _resize_trace_id)
        set(_resize_trace_dir "${WORK_DIR}/resize-trace-${_resize_trace_id}")
        file(MAKE_DIRECTORY "${_resize_trace_dir}")
        list(APPEND _environment "ASTRO_VULKAN_GAME_VIEW_RESIZE_TRACE_DIR=${_resize_trace_dir}")
    endif()
    if(STRESS_CYCLES)
        list(APPEND _environment "ASTRO_VULKAN_GAME_VIEW_RESIZE_CYCLES=${STRESS_CYCLES}")
    endif()
endif()
if(TAP_SIZE)
    list(APPEND _environment "ASTRO_VULKAN_GAME_VIEW_TAP_SIZE=${TAP_SIZE}")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env ${_environment}
        "${APP}" "${_argument}"
    RESULT_VARIABLE _result
    OUTPUT_VARIABLE _stdout
    ERROR_VARIABLE _stderr
    TIMEOUT 55)

if(VULKAN AND _result EQUAL 77)
    message(STATUS "VULKAN_BACKEND_UNAVAILABLE: linked BGFX build does not expose Vulkan; Game View texture smoke skipped")
    return()
endif()
if(VULKAN AND NOT COLOR_CHART AND NOT TAP AND _stdout MATCHES "VULKAN_GAME_VIEW_READBACK_MISMATCH")
    message(STATUS "VULKAN_GAME_VIEW_COMPOSITION_UNVERIFIED: ${_stdout}")
    return()
endif()
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Editor Runtime BGFX Game View texture smoke failed (${_result})\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "runtimeBgfxGameViewAdapter=1 runtimeBgfxGameViewSubmissions=2 runtimeBgfxGameViewCache=1 runtimeBgfxGameViewTextureSubmissions=2 runtimeBgfxGameViewTextureCache=2 runtimeBgfxGameViewMipTextureCache=1 runtimeBgfxGameViewMipFilter=${_filter} runtimeBgfxGameViewTexturePixels=[1-9][0-9]+ runtimeBgfxGameViewSourceTexturePixels=[1-9][0-9]+")
    message(FATAL_ERROR "Editor Play did not submit both project and external glTF base-color textures through BGFX\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "renderer ${_renderer}")
    message(FATAL_ERROR "Editor started with an unexpected renderer; expected ${_renderer}\n${_stdout}\n${_stderr}")
endif()
if(COLOR_CHART)
    if(NOT _stdout MATCHES "selected=VK_FORMAT_B8G8R8A8_UNORM bgfxColor=BGRA8 colorSpace=0")
        message(FATAL_ERROR "Vulkan surface format probe did not report BGRA8_UNORM/SRGB_NONLINEAR\n${_stdout}\n${_stderr}")
    endif()
    if(NOT _stdout MATCHES "vulkanColorChart matched=4/4 maxDelta=[0-8] channelTolerance=8/255")
        message(FATAL_ERROR "Vulkan known-color chart failed the bounded final-window comparison\n${_stdout}\n${_stderr}")
    endif()
    if(NOT EXISTS "${_screenshot}")
        message(FATAL_ERROR "Vulkan color chart smoke did not save its final-window screenshot: ${_screenshot}")
    endif()
    file(SIZE "${_screenshot}" _screenshot_size)
    if(_screenshot_size LESS 100000)
        message(FATAL_ERROR "Vulkan color chart screenshot is unexpectedly small (${_screenshot_size} bytes)")
    endif()
    message(STATUS "Vulkan BGRA8_UNORM surface known-color chart matched; final-window screenshot=${_screenshot}")
endif()
if(TAP)
    if(NOT _stdout MATCHES "vulkanGameViewTap target=[1-9][0-9]*x[1-9][0-9]* screen=[1-9][0-9]*x[1-9][0-9]* backbuffer=[1-9][0-9]*x[1-9][0-9]* captureWindow=[1-9][0-9]*x[1-9][0-9]* captureReset=[1-9][0-9]*x[1-9][0-9]* captureBackbuffer=[1-9][0-9]*x[1-9][0-9]* screenRect=[0-9]+,[0-9]+\\+[1-9][0-9]*x[1-9][0-9]* uvFlipY=[01] rowMatches=[0-9,]+ alternateRowMatches=[0-9,]+ probesBGRA=")
        message(FATAL_ERROR "Vulkan Game View tap smoke did not report target, UV, row and pixel-pair diagnostics\n${_stdout}\n${_stderr}")
    endif()
    if(NOT _stdout MATCHES "vulkanGameViewTapCapture windowPixels=[1-9][0-9]*x[1-9][0-9]* bgfxReset=[1-9][0-9]*x[1-9][0-9]* backbuffer=[1-9][0-9]*x[1-9][0-9]* vkSurfaceCurrent=[0-9]+x[0-9]+ currentDefined=[01] min=[1-9][0-9]*x[1-9][0-9]* max=[1-9][0-9]*x[1-9][0-9]* requested=")
        message(FATAL_ERROR "Vulkan Game View tap smoke did not report current surface limits and requested reset dimensions\n${_stdout}\n${_stderr}")
    endif()
    if(TAP_SIZE AND NOT _stdout MATCHES "vulkanGameViewTapCapture windowPixels=${TAP_SIZE} bgfxReset=${TAP_SIZE} backbuffer=${TAP_SIZE} vkSurfaceCurrent=[0-9]+x[0-9]+ currentDefined=[01] min=[1-9][0-9]*x[1-9][0-9]* max=[1-9][0-9]*x[1-9][0-9]* requested=${TAP_SIZE}")
        message(FATAL_ERROR "Vulkan Game View tap capture did not use the requested stable window/backbuffer size ${TAP_SIZE}\n${_stdout}\n${_stderr}")
    endif()
    if(TAP_SIZE STREQUAL "1100x720")
        if(STRESS_CYCLES)
            string(REGEX MATCHALL "vulkanResizeTrace event=reset frame=[0-9]+ from=[0-9]+x[0-9]+ requested=[0-9]+x[0-9]+ statsBefore=[0-9]+x[0-9]+" _resize_events "${_stdout}")
            math(EXPR _expected_resize_events "${STRESS_CYCLES} * 2")
            list(LENGTH _resize_events _resize_event_count)
            if(NOT _resize_event_count EQUAL _expected_resize_events)
                message(FATAL_ERROR "Vulkan stress trace expected ${_expected_resize_events} ordered resize events, found ${_resize_event_count}\n${_stdout}\n${_stderr}")
            endif()
            foreach(_event_index RANGE 0 ${_expected_resize_events})
                if(_event_index GREATER_EQUAL _expected_resize_events)
                    break()
                endif()
                list(GET _resize_events ${_event_index} _resize_event)
                math(EXPR _event_phase "${_event_index} % 2")
                if(_event_phase EQUAL 0)
                    if(NOT _resize_event MATCHES "from=1100x720 requested=1280x800")
                        message(FATAL_ERROR "Vulkan stress cycle ${STRESS_CYCLES} did not grow from 1100x720 to 1280x800 at transition ${_event_index}: ${_resize_event}")
                    endif()
                elseif(NOT _resize_event MATCHES "from=1280x800 requested=1100x720")
                    message(FATAL_ERROR "Vulkan stress cycle ${STRESS_CYCLES} did not shrink from 1280x800 to 1100x720 at transition ${_event_index}: ${_resize_event}")
                endif()
            endforeach()
            set(_resize_to_large "${_resize_events}")
            set(_resize_to_small "${_resize_events}")
        else()
            string(REGEX MATCH "vulkanResizeTrace event=reset frame=[0-9]+ from=1100x720 requested=1280x800 statsBefore=[0-9]+x[0-9]+" _resize_to_large "${_stdout}")
            string(REGEX MATCH "vulkanResizeTrace event=reset frame=[0-9]+ from=1280x800 requested=1100x720 statsBefore=[0-9]+x[0-9]+" _resize_to_small "${_stdout}")
        endif()
        string(REGEX MATCHALL "vulkanResizeTrace event=frame frame=[0-9]+ requested=1100x720 stats=[0-9]+x[0-9]+" _small_post_reset_frames "${_stdout}")
        string(REGEX MATCH "vulkanGameViewTap target=[^\r\n]*" _tap_dimensions "${_stdout}")
        if(NOT _resize_to_large OR NOT _resize_to_small OR NOT _small_post_reset_frames OR NOT _tap_dimensions)
            message(FATAL_ERROR "Vulkan resize trace did not capture both deterministic size transitions and a subsequent frame\n${_stdout}\n${_stderr}")
        endif()
        message(STATUS "Vulkan resize trace: ${_resize_to_large}; ${_resize_to_small}; ${_small_post_reset_frames}")
        message(STATUS "Vulkan capture dimensions: ${_tap_dimensions}")
        file(GLOB _resize_trace_files "${_resize_trace_dir}/vulkan-resize-frame-*.tga")
        list(SORT _resize_trace_files COMPARE NATURAL ORDER ASCENDING)
        list(LENGTH _resize_trace_files _resize_trace_file_count)
        if(STRESS_CYCLES)
            math(EXPR _expected_resize_file_count "1 + ${STRESS_CYCLES} * 4")
        else()
            set(_expected_resize_file_count 9)
        endif()
        if(NOT _resize_trace_file_count EQUAL _expected_resize_file_count)
            message(FATAL_ERROR "Vulkan resize trace expected ${_expected_resize_file_count} BGFX captures, found ${_resize_trace_file_count}\n${_stdout}\n${_stderr}")
        endif()
        set(_resize_trace_index 0)
        foreach(_trace_file IN LISTS _resize_trace_files)
            file(READ "${_trace_file}" _tga_header LIMIT 18 HEX)
            string(SUBSTRING "${_tga_header}" 24 2 _width_low)
            string(SUBSTRING "${_tga_header}" 26 2 _width_high)
            string(SUBSTRING "${_tga_header}" 28 2 _height_low)
            string(SUBSTRING "${_tga_header}" 30 2 _height_high)
            math(EXPR _trace_width "0x${_width_high}${_width_low}")
            math(EXPR _trace_height "0x${_height_high}${_height_low}")
            if(_trace_width LESS 1 OR _trace_height LESS 1)
                message(FATAL_ERROR "Vulkan resize screenshot has an invalid TGA extent: ${_trace_file}")
            endif()
            if(_resize_trace_index EQUAL 0)
                set(_expected_width 1100)
                set(_expected_height 720)
            elseif(STRESS_CYCLES)
                math(EXPR _transition_index "(${_resize_trace_index} - 1) / 2")
                math(EXPR _transition_phase "${_transition_index} % 2")
                if(_transition_phase EQUAL 0)
                    set(_expected_width 1280)
                    set(_expected_height 800)
                else()
                    set(_expected_width 1100)
                    set(_expected_height 720)
                endif()
            elseif(_resize_trace_index LESS 5)
                set(_expected_width 1280)
                set(_expected_height 800)
            else()
                set(_expected_width 1100)
                set(_expected_height 720)
            endif()
            if(NOT _trace_width EQUAL _expected_width OR NOT _trace_height EQUAL _expected_height)
                message(FATAL_ERROR
                    "Vulkan swapchain resize capture ${_resize_trace_index} expected ${_expected_width}x${_expected_height}, got ${_trace_width}x${_trace_height}: ${_trace_file}\n${_stdout}\n${_stderr}")
            endif()
            get_filename_component(_trace_name "${_trace_file}" NAME_WE)
            message(STATUS "${_trace_name} BGFX screenshot=${_trace_width}x${_trace_height}")
            math(EXPR _resize_trace_index "${_resize_trace_index} + 1")
        endforeach()
    endif()
    if(NOT _stdout MATCHES "framebufferReadback case=game-vulkan-texture scene=not-checked game=[1-9][0-9]*/768 maxDelta=[0-9]+.*gameThreshold=99\.5%")
        message(FATAL_ERROR "Vulkan Game View tap smoke did not preserve the 768-point readback measurement\n${_stdout}\n${_stderr}")
    endif()
    message(STATUS "Vulkan Game View target/window tap metrics captured; visual parity remains separately gated")
endif()
if(MASK)
    set(_expected_readback_case "game-mask")
elseif(VULKAN)
    set(_expected_readback_case "game-vulkan-texture")
else()
    set(_expected_readback_case "game-texture")
endif()
if(NOT COLOR_CHART AND NOT _stdout MATCHES "framebufferReadback case=${_expected_readback_case} scene=not-checked game=[0-9]+/[0-9]+ maxDelta=[0-9]+ sceneThreshold=[0-9.]+% gameThreshold=99\.5% channelTolerance=8/255")
    message(FATAL_ERROR "Runtime Game View did not report Editor framebuffer readback for ${_expected_readback_case}\n${_stdout}\n${_stderr}")
endif()
if(NOT COLOR_CHART)
    string(REGEX MATCH "framebufferReadback case=${_expected_readback_case} scene=not-checked game=([0-9]+)/([0-9]+) maxDelta=([0-9]+)"
        _readback_metrics "${_stdout}")
    message(STATUS "${_renderer} ${_expected_readback_case} Game framebuffer vs final-window samples: ${CMAKE_MATCH_1}/${CMAKE_MATCH_2}, maxDelta=${CMAKE_MATCH_3} (threshold: 99.5%, per-channel tolerance 8/255)")
endif()
string(REGEX MATCH "runtimeBgfxGameViewMipFilter=${_filter} runtimeBgfxGameViewTexturePixels=([0-9]+) runtimeBgfxGameViewSourceTexturePixels=([0-9]+)" _metrics "${_stdout}")
set(_project_pixels "${CMAKE_MATCH_1}")
set(_source_pixels "${CMAKE_MATCH_2}")
if(COLOR_CHART)
    if(_source_pixels LESS 64 OR _source_pixels GREATER 10000)
        message(FATAL_ERROR "Runtime Vulkan chart smoke found unexpected textured-screen coverage (${_source_pixels})\n${_stdout}")
    endif()
elseif(TAP)
    if(_source_pixels LESS 64 OR _source_pixels GREATER 10000)
        message(FATAL_ERROR "Runtime Vulkan tap smoke found unexpected textured-screen coverage (${_source_pixels})\n${_stdout}")
    endif()
elseif(MASK)
    if(_source_pixels LESS 64 OR _source_pixels GREATER 400)
        message(FATAL_ERROR "Runtime MASK alpha-cutout produced unexpected checker coverage (${_source_pixels})\n${_stdout}")
    endif()
elseif(_filter STREQUAL "9984" OR _filter STREQUAL "9986")
    # The 07.2cc linear-to-sRGB output transfer changes how many antialiased
    # edge texels cross this screenshot's cyan classifier. Keep the bounded
    # visibility assertion; exact color transfer is checked by the dedicated
    # four-shader numeric screenshot smoke.
    if(_source_pixels LESS 64 OR _source_pixels GREATER 700)
        message(FATAL_ERROR "Nearest-mip sampler modes produced unexpected checker coverage (${_source_pixels})\n${_stdout}")
    endif()
else()
    if(_source_pixels LESS 400 OR _source_pixels GREATER 700)
        message(FATAL_ERROR "Linear-mip sampler modes produced unexpected checker coverage (${_source_pixels})\n${_stdout}")
    endif()
endif()
if(NOT EXISTS "${_screenshot}")
    message(FATAL_ERROR "Editor did not save the textured Runtime BGFX Game View screenshot: ${_screenshot}")
endif()
file(SIZE "${_screenshot}" _screenshot_size)
if(_screenshot_size LESS 100000)
    message(FATAL_ERROR "Textured Runtime BGFX Game View screenshot is unexpectedly small (${_screenshot_size} bytes)")
endif()
message(STATUS "Runtime BGFX mip filter=${_filter}; mask=${MASK}; projectPixels=${_project_pixels}; sourcePixels=${_source_pixels}; screenshot=${_screenshot}")
