if(NOT DEFINED APP OR NOT EXISTS "${APP}")
    message(FATAL_ERROR "Runtime BGFX point-light smoke app does not exist: ${APP}")
endif()
if(NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "Runtime BGFX point-light smoke requires a build-local WORK_DIR")
endif()

file(MAKE_DIRECTORY "${WORK_DIR}")
set(_screenshot "${WORK_DIR}/runtime-bgfx-point-light.tga")
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "ASTRO_EDITOR_SCREENSHOT_OUTPUT=${_screenshot}"
        "${APP}" --smoke-runtime-bgfx-point-light
    RESULT_VARIABLE _result OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 55)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Runtime BGFX point-light smoke failed (${_result})\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "runtimeBgfxPointLightPixels=[1-9][0-9]*")
    message(FATAL_ERROR "Runtime Game View has no point-lit pixels\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "sceneViewPointLightPixels=[1-9][0-9]*")
    message(FATAL_ERROR "Editor Scene View has no point-lit pixels\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "pointLightInspectorControls=1"
        OR NOT _stdout MATCHES "pointLightInspectorCommands=1")
    message(FATAL_ERROR "PointLight3D Inspector controls/command regression failed\n${_stdout}\n${_stderr}")
endif()
if(NOT _stdout MATCHES "lightInspectorKeyboard=1 target=point enabledDraft=1 valueFieldEdited=1 draftOnly=1 sceneUnchanged=1 sdl=1")
    message(FATAL_ERROR "PointLight3D Inspector keyboard regression failed\n${_stdout}\n${_stderr}")
endif()
string(REGEX MATCH "lightInspectorKeyboardProbe=[^\r\n]*" _keyboard_probe "${_stdout}")
if(NOT _keyboard_probe)
    message(FATAL_ERROR "Point-light keyboard probe did not report activation state\n${_stdout}\n${_stderr}")
endif()
if(NOT EXISTS "${_screenshot}")
    message(FATAL_ERROR "Runtime BGFX point-light screenshot was not saved: ${_screenshot}")
endif()
file(SIZE "${_screenshot}" _screenshot_size)
if(_screenshot_size LESS 100000)
    message(FATAL_ERROR "Runtime BGFX point-light screenshot is too small (${_screenshot_size} bytes)")
endif()
message(STATUS "Point-light Inspector controls and transactional command smoke passed; ${_keyboard_probe}; screenshot=${_screenshot}")
