if(CASE STREQUAL "help")
    set(argument "--help")
    set(expected_exit "0")
elseif(CASE STREQUAL "invalid")
    set(argument "--unknown")
    set(expected_exit "2")
else()
    message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()
execute_process(COMMAND "${APP}" "${argument}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 10)
if(NOT "${result}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Unexpected exit: ${result}; stderr: ${errors}")
endif()
if(CASE STREQUAL "help")
    if(NOT output MATCHES "Usage: astro_headless" OR NOT "${errors}" STREQUAL "")
        message(FATAL_ERROR "Invalid help output: ${output}; stderr: ${errors}")
    endif()
else()
    if(NOT errors MATCHES "\\[error\\] Invalid arguments" OR NOT "${output}" STREQUAL "")
        message(FATAL_ERROR "Invalid error output: ${output}; stderr: ${errors}")
    endif()
endif()
